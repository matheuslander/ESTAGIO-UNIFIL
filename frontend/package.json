{
  "name": "unicontrol-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0 --port 5173 --strictPort\" \"wait-on http://localhost:5173 && electron .\"",
